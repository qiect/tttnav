    <script>
        jQuery(document).ready(function($) {
            $('.count').each(function() {
                var $this = $(this);
                var countTo = $this.text();
                $this.text('0');

                $this.animate({
                    num: countTo
                }, {
                    duration: 1500,
                    step: function(now) {
                        $this.text(Math.floor(now));
                    },
                    complete: function() {
                        $this.text(countTo);
                    }
                });
            });
        });
    </script>
